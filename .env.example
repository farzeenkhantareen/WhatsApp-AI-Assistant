# Application
APP_NAME=WhatsApp AI Assistant
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=*
INTERNAL_API_KEY=change-me-internal-api-key
WEBHOOK_SECRET=change-me-webhook-secret

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
OPENROUTER_AUDIO_MODEL=openai/gpt-4o-audio-preview
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=2048
OPENROUTER_SITE_URL=https://localhost
OPENROUTER_APP_NAME=WhatsApp-AI-Assistant

# Database (app)
DATABASE_URL=postgresql+asyncpg://whatsapp:whatsapp@postgres:5432/whatsapp_ai

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_MEMORY_TTL=86400
MEMORY_WINDOW_SIZE=40
MESSAGE_DEBOUNCE_SECONDS=1.5

# Evolution API
EVOLUTION_URL=http://evolution-api:8080
EVOLUTION_API_KEY=change-me-evolution-api-key
INSTANCE_NAME=whatsapp-ai
WEBHOOK_URL=http://backend:8000/webhook
AUTO_CREATE_INSTANCE=true

# AI behaviour
SYSTEM_PROMPT=You are a helpful WhatsApp assistant. Answer naturally, concisely, and keep conversation context. Never invent facts about the business; use tools or knowledge when unsure.
KNOWLEDGE_DIR=app/prompts/knowledge
RATE_LIMIT_PER_MINUTE=60

# Postgres (docker-compose)
POSTGRES_USER=whatsapp
POSTGRES_PASSWORD=whatsapp
POSTGRES_DB=whatsapp_ai
EVOLUTION_DB=evolution