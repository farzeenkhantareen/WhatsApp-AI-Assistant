# Server
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# Security
API_KEY=change-me-to-a-long-random-secret

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Bailey WhatsApp AI Assistant

# AI behavior
SYSTEM_PROMPT=You are a helpful WhatsApp assistant. Be concise, friendly, and accurate.
MAX_CONTEXT_MESSAGES=20
AI_MAX_RETRIES=3
SEND_MAX_RETRIES=3

# Database
DATABASE_URL=postgresql://bailey:bailey@localhost:5432/bailey?schema=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_CONV_TTL_SECONDS=3600

# WhatsApp / Baileys
AUTH_DIR=./auth_info
MEDIA_DIR=./media
ALLOW_GROUPS=false
MAX_MEDIA_BYTES=16777216

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
